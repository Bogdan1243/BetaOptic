# ============================================================================
# META WHATSAPP CLOUD API & GOOGLE SHEETS AUDIT LOG — ENVIRONMENT VARIABLES
# Adaugă aceste variabile în Vercel Dashboard -> Settings -> Environment Variables
# (sau într-un fișier local .env pentru testare cu `vercel dev`)
# ============================================================================

# 1. Token-ul de acces din Meta Developers (WhatsApp -> API Setup sau System User Token permanent)
WHATSAPP_TOKEN=

# 2. Phone Number ID din Meta Developers (WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID=

# 3. Numele șablonului aprobat în Meta WhatsApp Manager
#    Lasă "hello_world" pentru testarea inițială imediată cu numărul de test Meta,
#    apoi schimbă în "voucher_beta_optic" după ce șablonul în limba română este aprobat.
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANG=en_US

# 4. Token-ul de verificare pentru Webhook-ul Meta (pentru dezabonare automată la răspuns "STOP")
WHATSAPP_WEBHOOK_VERIFY_TOKEN=betaoptic_verify_token

# 5. URL-ul Web App din Google Sheets (Extensions -> Apps Script -> Deploy)
#    unde se salvează automat tabelul cu numerele de telefon, codurile și dovada GDPR
GOOGLE_SHEET_WEBHOOK_URL=
